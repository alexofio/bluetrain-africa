    "js-yaml": "^4.3.2",
    "marked": "^14.1.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "^4.150.0"
