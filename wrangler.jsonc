{
  // bluetrain.africa — built and deployed by Cloudflare Workers Builds on every push to main.
  // Build command: npm run build   ·   Deploy command: npx wrangler deploy
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bluetrain-africa",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-13",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only the editor's GitHub sign-in runs code; everything else is served straight from dist/.
    "run_worker_first": ["/auth", "/callback"]
  },
  "observability": { "enabled": true }
}
